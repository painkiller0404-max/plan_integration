<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Section heading in Settings > Users > Access Rights -->
        <record id="module_category_plan_integration" model="ir.module.category">
            <field name="name">Plan d'Intégration</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privilege (Odoo 19): the selectable item in the user Access Rights tab -->
        <record id="privilege_plan_integration" model="res.groups.privilege">
            <field name="name">Plan d'Intégration</field>
            <field name="category_id" ref="module_category_plan_integration"/>
            <field name="sequence">10</field>
        </record>

        <!-- Group: Responsable RH — linked via privilege_id (Odoo 19) -->
        <record id="group_plan_integration_hr" model="res.groups">
            <field name="name">Responsable RH</field>
            <field name="privilege_id" ref="privilege_plan_integration"/>
        </record>
    </data>
</odoo>

